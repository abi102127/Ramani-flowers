    background:#fff;
    color:#4b1d2b;
}

button{
    cursor:pointer;
}

/* ================= TOP BAR ================= */

.topbar{
    height:34px;
    background:#fde5ed;
    display:flex;
    justify-content:space-around;
    align-items:center;
    font-size:12px;
    color:#5b3944;
}

/* ================= HEADER ================= */

header{
    height:78px;
    display:flex;
    align-items:center;
    justify-content:space-between;
    padding:0 5%;
    background:white;
    border-bottom:1px solid #eee;
    position:sticky;
    top:0;
    z-index:1000;
}

.menu{
    font-size:27px;
    cursor:pointer;
}

.logo{
    text-align:center;
}

.logo h1{
    font-family:Georgia,serif;
    font-size:27px;
    letter-spacing:2px;
    color:#682538;
}

.logo p{
    font-size:7px;
    letter-spacing:3px;
    color:#a67a87;
}

.nav{
    display:flex;
    gap:25px;
}

.nav a{
    text-decoration:none;
    color:#542532;
    font-size:13px;
}

.nav a:hover{
    color:#e73872;
}

.header-right{
    display:flex;
    gap:20px;
    font-size:22px;
}

.header-right span{
    cursor:pointer;
}

/* ================= HERO ================= */

.hero{
    width:92%;
    max-width:1250px;
    height:400px;
    margin:20px auto;
    position:relative;
    overflow:hidden;
    border-radius:22px;
}

.slide{
    position:absolute;
    width:100%;
    height:100%;
    display:flex;
    opacity:0;
    transform:translateX(100%);
    transition:.7s;
}

.slide.active{
    opacity:1;
    transform:translateX(0);
}

.hero-text{
    width:48%;
    padding:70px 55px;
    background:#ffe8ef;
}

.script{
    font-family:cursive;
    font-size:25px;
    color:#df4d7b;
}

.hero-text h2{
    font-family:Georgia,serif;
    font-size:44px;
    line-height:1.1;
    margin:12px 0 20px;
}

.hero-text p{
    color:#66545a;
    line-height:1.5;
}

.shop-btn{
    margin-top:25px;
    padding:14px 27px;
    border:0;
    border-radius:25px;
    background:#e83d75;
    color:white;
    font-weight:bold;
}

.hero-image{
    width:52%;
    height:100%;
    object-fit:cover;
}

.dots{
    position:absolute;
    bottom:14px;
    left:50%;
    transform:translateX(-50%);
    z-index:5;
}

.dot{
    display:inline-block;
    width:10px;
    height:10px;
    background:#ddd;
    border-radius:50%;
    margin:4px;
}

.dot.active{
    background:#e83d75;
}

/* ================= COMMON ================= */

.container{
    width:92%;
    max-width:1250px;
    margin:35px auto;
}

.title-row{
    display:flex;
    justify-content:space-between;
    align-items:center;
    margin-bottom:18px;
}

.title-row h2{
    font-family:Georgia,serif;
    font-size:25px;
}

.view{
    color:#e23b72;
    font-weight:bold;
}

/* ================= PRODUCTS ================= */

.products{
    display:grid;
    grid-template-columns:repeat(4,1fr);
    gap:18px;
}

.card{
    border:1px solid #eee;
    border-radius:15px;
    padding:10px;
    text-align:center;
    box-shadow:0 4px 14px rgba(100,30,50,.08);
    background:white;
    transition:.3s;
}

.card:hover{
    transform:translateY(-5px);
}

.card-image{
    position:relative;
}

.card-image img{
    width:100%;
    height:190px;
    object-fit:cover;
    border-radius:12px;
}

.heart{
    position:absolute;
    right:10px;
    top:10px;
    width:30px;
    height:30px;
    border-radius:50%;
    background:white;
    display:flex;
    justify-content:center;
    align-items:center;
    color:#e83d75;
    font-size:20px;
}

.card h3{
    font-size:14px;
    margin:10px 0 7px;
}

.price{
    color:#e63370;
    font-size:17px;
    font-weight:bold;
}

.add-btn{
    width:90%;
    margin:10px auto 3px;
    padding:9px;
    border:1px solid #efa9bd;
    background:white;
    color:#df3c72;
    border-radius:9px;
    font-weight:bold;
}

.add-btn:hover{
    background:#e83d75;
    color:white;
}

/* ================= COMBO ================= */

.combo .card-image img{
    height:170px;
}

.combo-text{
    font-size:12px;
    color:#666;
    line-height:1.4;
}

/* ================= WHY ================= */

.why{
    background:#ffe9f0;
    border-radius:20px;
    padding:28px;
    display:flex;
    align-items:center;
    gap:30px;
}

.why-left{
    flex:1;
}

.why-left h2{
    font-family:Georgia,serif;
    margin-bottom:20px;
}

.features{
    display:grid;
    grid-template-columns:repeat(5,1fr);
    gap:10px;
}

.feature{
    text-align:center;
}

.feature-icon{
    font-size:28px;
    margin-bottom:8px;
}

.feature h4{
    font-size:11px;
}

.feature p{
    color:#777;
    font-size:10px;
    margin-top:5px;
}

.why-image{
    width:38%;
    height:170px;
    object-fit:cover;
    border-radius:15px;
}

/* ================= ABOUT ================= */

.about{
    display:flex;
    gap:30px;
    align-items:center;
}

.about-image{
    width:40%;
    height:230px;
    object-fit:cover;
    border-radius:18px;
}

.about-content{
    flex:1;
}

.about-content small{
    color:#df3c72;
    font-weight:bold;
}

.about-content h2{
    font-family:Georgia,serif;
    font-size:28px;
    margin:7px 0 12px;
}

.about-content p{
    color:#666;
    line-height:1.6;
    font-size:14px;
}

.about-points{
    display:flex;
    gap:35px;
    margin-top:20px;
}

.about-points div{
    text-align:center;
    font-size:11px;
}

/* ================= OFFER ================= */

.offer{
    background:#ffe4ed;
    border-radius:20px;
    padding:25px;
    display:flex;
    align-items:center;
    justify-content:space-between;
}

.offer h2{
    color:#e73470;
    font-family:Georgia,serif;
    font-size:28px;
}

.offer p{
    margin-top:7px;
    color:#555;
}

.offer button{
    border:0;
    background:#e83d75;
    color:white;
    padding:13px 25px;
    border-radius:22px;
    font-weight:bold;
}

/* ================= REVIEWS ================= */

.reviews{
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:18px;
}

.review{
    background:#fff6f8;
    border-radius:15px;
    padding:20px;
    border:1px solid #f6dce4;
}

.person{
    display:flex;
    align-items:center;
    gap:12px;
    margin-bottom:12px;
}

.person-img{
    width:48px;
    height:48px;
    border-radius:50%;
    object-fit:cover;
}

.review p{
    color:#666;
    font-size:13px;
    line-height:1.5;
}

.stars{
    color:#f49b20;
    margin-top:10px;
}

/* ================= GALLERY ================= */

.gallery{
    display:grid;
    grid-template-columns:repeat(7,1fr);
    gap:10px;
}

.gallery img{
    width:100%;
    height:120px;
    object-fit:cover;
    border-radius:10px;
}

/* ================= CONTACT ================= */

.contact{
    background:#fff0f4;
    border-radius:20px;
    padding:30px;
    text-align:center;
}

.contact h2{
    font-family:Georgia,serif;
    margin-bottom:10px;
}

.contact p{
