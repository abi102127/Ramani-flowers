    margin:6px;
}

.contact-btn{
    margin-top:15px;
    padding:12px 25px;
    border:0;
    border-radius:22px;
    background:#e83d75;
    color:white;
    font-weight:bold;
}

/* ================= FOOTER ================= */

footer{
    background:#fde8ef;
    margin-top:45px;
    padding:40px 6% 20px;
}

.footer-grid{
    display:grid;
    grid-template-columns:2fr 1fr 1fr 1.5fr 1.5fr;
    gap:30px;
}

.footer-logo{
    font-family:Georgia,serif;
    font-size:24px;
    font-weight:bold;
