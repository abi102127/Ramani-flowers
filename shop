    }

    .card-image img{
        height:135px;
    }

    .combo .card-image img{
        height:120px;
    }

    .card h3{
        font-size:11px;
    }

    .price{
        font-size:14px;
    }

    .add-btn{
        font-size:9px;
    }

    .why{
        display:block;
        padding:18px;
    }

    .features{
        grid-template-columns:repeat(5,1fr);
    }

    .why-image{
        width:100%;
        height:160px;
        margin-top:20px;
    }

    .about{
        display:block;
    }

    .about-image{
        width:100%;
        height:190px;
    }

    .about-content{
        margin-top:20px;
    }

    .about-content h2{
        font-size:22px;
    }

    .about-points{
        gap:10px;
        justify-content:space-between;
    }

    .offer{
        padding:20px;
        display:block;
        text-align:center;
    }

    .offer h2{
        font-size:22px;
    }

    .offer button{
        margin-top:15px;
    }

    .reviews{
        grid-template-columns:1fr;
    }

    .gallery{
        grid-template-columns:repeat(4,1fr);
    }

    .gallery img{
        height:80px;
    }

    .footer-grid{
        grid-template-columns:1fr 1fr;
    }

    .footer-about{
        grid-column:1/-1;
    }

    .newsletter{
        grid-column:1/-1;
    }
}
/* ================= BLINKING IMAGES ================= */

.card-image img,
.why-image,
.about-image,
.gallery img,
.person-img{
    animation: flowerBlink 2.5s ease-in-out infinite;
}

/* Different timing makes the images blink naturally */
.card:nth-child(2) img{
    animation-delay:0.3s;
}

.card:nth-child(3) img{
    animation-delay:0.6s;
}

.card:nth-child(4) img{
    animation-delay:0.9s;
}

.gallery img:nth-child(2){
    animation-delay:0.2s;
}

.gallery img:nth-child(3){
    animation-delay:0.4s;
}

.gallery img:nth-child(4){
    animation-delay:0.6s;
}

.gallery img:nth-child(5){
    animation-delay:0.8s;
}

.gallery img:nth-child(6){
    animation-delay:1s;
}

.gallery img:nth-child(7){
    animation-delay:1.2s;
}

@keyframes flowerBlink{

    0%{
        opacity:1;
        transform:scale(1);
    }

    50%{
        opacity:0.55;
        transform:scale(1.03);
    }

    100%{
        opacity:1;
        transform:scale(1);
    }

}

</style>
